# Optional server-side GitHub token.
# - Public repositories work without it, subject to unauthenticated rate limits (60 req/h).
# - Private repositories can be analyzed when this token has read access to the target repo.
# Never exposed to the browser. Prefer a fine-grained, read-only token scoped to only the repos AppGraph must inspect.
GITHUB_TOKEN=

# Directory used for the filesystem analysis cache. Defaults to <project>/.appgraph-cache
APPGRAPH_CACHE_DIR=

# Bump to invalidate all cached analyses after analyzer changes.
# Default analyzer revision is 0.7.0 (bounded layout for dense graphs).
APPGRAPH_ANALYSIS_VERSION=0.7.0

# Rate limit for POST /api/repositories/analyze (requests per 5 minutes per client).
APPGRAPH_ANALYZE_RATE_LIMIT=12

# Maximum number of repository analyses running concurrently in this process.
APPGRAPH_MAX_CONCURRENT_ANALYSES=3

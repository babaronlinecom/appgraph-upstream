datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id        String        @id @default(cuid())
  name      String        @unique
  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  tasks     Task[]

  @@map("projects")
}

model Task {
  id        String  @id @default(cuid())
  title     String
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}

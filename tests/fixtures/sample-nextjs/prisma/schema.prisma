datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id        String  @id @default(cuid())
  title     String
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}
